# Environment variables template (safe to commit)

# Provider: NVIDIA NIM (Poolside Laguna XS 2.1)
# Get your key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here

# MCP: Context7 (docs search) - optional, increases rate limits
# Get your key from https://context7.com
CONTEXT7_API_KEY=ctx7sk-your-key-here

# MCP: Exa (web search / research)
# Get your key from https://exa.ai
EXA_API_KEY=your-exa-api-key-here

# Project specific (Next.js + FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hogwarts_nexus
JWT_SECRET=generate_a_long_random_string_here
