# Environment variables for Hogwarts Nexus Lumiere
# Copy this file to .env and fill in the values

# ===== Database Configuration =====
# For local development (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# For Turso (production):
# TURSO_DATABASE_URL=your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
# 
# Alternative: set DATABASE_URL directly to the full Turso URL
# DATABASE_URL=sqlite+libsql://your-db-name.turso.io?auth_token=your-token

# ===== JWT Settings =====
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Access token expiry (minutes). Defaults to 30.
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Set to true in production so auth cookies are only sent over HTTPS.
# COOKIE_SECURE=true

# ===== Cloudinary Settings (for file uploads) =====
# Get these from your Cloudinary account dashboard
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ===== Optional Settings =====
# Message retention (days)
MESSAGE_RETENTION_DAYS=90

# Pet care settings
HUNGER_DECAY_PER_HOUR=5.0
HAPPINESS_DECAY_PER_HOUR=3.0
PET_LIFESPAN_DAYS=120
PET_FAREWELL_WARN_FRACTION=0.85
PET_ATTENTION_HUNGER=20
PET_ATTENTION_HAPPINESS=20
PET_CARE_SWEEP_HOURS=6

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=